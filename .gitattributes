# Auto detect text files and convert to LF (standard for cross-platform consistency)
* text=auto

# Python source files
*.py text diff=python

# Shell scripts - always LF
*.sh text eol=lf

# Windows batch scripts - always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts - always CRLF
*.ps1 text eol=crlf

# Configuration files
*.yml text
*.yaml text
*.json text
*.toml text
*.ini text
*.cfg text
*.conf text

# Documentation
*.md text
*.rst text
*.txt text

# Generated files - treat as binary
*.pyc binary
*.pyo binary
*.egg-info/** binary
*.eggs binary
__pycache__/** binary

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.ico binary
*.zip binary
*.tar.gz binary
*.gz binary
