@echo off
chcp 65001 >nul
echo ==========================================
echo      ACAS Pro LLM API 服务
echo ==========================================
echo.

:: 检查 Python
python --version >nul 2>&1
if errorlevel 1 (
    echo [错误] 未找到 Python
    pause
    exit /b 1
)

:: 检查依赖
echo [1/2] 检查依赖...
pip show flask flask-cors >nul 2>&1
if errorlevel 1 (
    echo      安装 Flask...
    pip install flask flask-cors -q
)

:: 从 .env 文件加载配置
if exist ".env" (
    echo [2/2] 从 .env 加载配置...
    for /f "tokens=1,2 delims==" %%a in (.env) do (
        set "%%a=%%b"
    )
)

:: 设置环境变量
if not defined LLM_PROVIDER set LLM_PROVIDER=deepseek
if not defined LLM_MODEL set LLM_MODEL=deepseek-chat

echo.
echo ==========================================
echo      配置信息
echo ==========================================
echo Provider: %LLM_PROVIDER%
echo Model: %LLM_MODEL%
echo API Key: %LLM_API_KEY:~0,10%... 
echo.

if not defined LLM_API_KEY (
    echo [警告] 未设置 LLM_API_KEY
    echo 请先设置环境变量或在 .env 文件中配置
    echo.
    echo 格式:
    echo LLM_PROVIDER=deepseek
    echo LLM_API_KEY=sk-...
    echo LLM_MODEL=deepseek-chat
    echo.
    pause
    exit /b 1
)

echo 启动 LLM API 服务...
echo 地址: http://localhost:5002
echo.
python llm_api.py
