[run]
omit =
    */ui/pages/llm_chat.py
    */ui/pages/llm_chat_fixed.py
    */monitoring/metrics.py
    */ui/pages/*
    */ui/main_window.py
    */ui/auth/login_dialog.py
    */core/async_utils.py
    */llm/claude_engine.py
    */llm/gemini_engine.py
    */video/video_maker.py
    */video/voice_synthesis.py
    */web/api_spec.py
    */ads/ad_manager.py
    */ads/audience_targeting.py

[report]
show_missing = true
