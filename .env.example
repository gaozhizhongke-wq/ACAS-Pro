# ACAS Pro Environment Configuration (Template)
# Copy to `.env` and fill in real values. NEVER commit `.env` itself.
# This file is safe to commit (no real secrets).

ACAS_ENV=development

# ── CORS (Required in production) ─────────────────────────────────────────────
# Comma-separated list of allowed origins. Wildcard (*) is blocked in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ── LLM Configuration ───────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
DEEPSEEK_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat

# ── Database Configuration ────────────────────────────────────────────────────
# PostgreSQL (production recommended):
# DATABASE_URL=postgresql://acas_user:YOUR_PASSWORD@localhost:5432/acas_pro
#
# SQLite (development fallback only, blocked when ACAS_ENV=production):
# DATABASE_URL=sqlite:///./data/acas.db
DATABASE_URL=postgresql://acas_user:YOUR_PASSWORD@localhost:5432/acas_pro

# ── Redis Configuration ────────────────────────────────────────────────────────
# For production rate limiting (multi-process safe).
# For development without Redis: comment out to use in-memory fallback.
# REDIS_URL=redis://localhost:6379/0

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_64_char_hex_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── API Configuration ──────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_LLM=true
ENABLE_BLOCKCHAIN=true
ENABLE_VIDEO_EDITING=true
