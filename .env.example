# ACAS Pro v2.1 - Production Configuration
# 高智中科（北京）科技有限公司
# 
# 安全警告：生产环境必须修改以下配置！
# ===========================================

# ===========================================
# 1. 安全基线配置（必须修改）
# ===========================================

# JWT 密钥（首次启动自动生成，或手动设置）
# 生产环境必须设置强密钥，至少 32 字节
# JWT_SECRET=your-super-secret-key-at-least-32-characters

# CORS 白名单（逗号分隔，生产环境必须限制）
# 示例: https://acas.gaozhizhongke.com,https://admin.gaozhizhongke.com
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ===========================================
# 2. SSL/TLS 配置（生产环境必须启用）
# ===========================================

# SSL 证书路径（Let's Encrypt 或其他 CA）
# SSL_CERT_FILE=/etc/letsencrypt/live/acas.gaozhizhongke.com/fullchain.pem
# SSL_KEY_FILE=/etc/letsencrypt/live/acas.gaozhizhongke.com/privkey.pem

# 证书自动续期邮箱
# CERT_EMAIL=admin@gaozhizhongke.com

# ===========================================
# 3. 数据库配置（生产环境必须使用 PostgreSQL）
# ===========================================

# SQLite（开发/测试环境）
DATABASE_URL=sqlite:///acas_pro.db

# PostgreSQL（生产环境）
# DATABASE_URL=postgresql://user:password@localhost:5432/acas_pro

# PostgreSQL 连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ===========================================
# 4. 服务配置
# ===========================================

# 服务监听地址和端口
HOST=0.0.0.0
PORT=5000

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===========================================
# 5. 外部服务配置
# ===========================================

# DeepSeek API（可选）
# DEEPSEEK_API_KEY=sk-your-api-key-here
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Redis（可选，用于缓存和 Session）
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# 6. 备份配置
# ===========================================

# 备份保留天数
BACKUP_KEEP_DAYS=7

# 备份目录
BACKUP_DIR=backups

# ===========================================
# 7. 监控配置（可选）
# ===========================================

# Prometheus 指标端口
METRICS_PORT=9090

# 健康检查详细程度: simple, detailed
HEALTH_CHECK_LEVEL=detailed
